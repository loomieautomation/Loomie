function openBk(){const u=window.loomieUser;if(u&&!$("bk-f1").email.value)$("bk-f1").email.value=u.email;sel=null;slot=null;$("bk-e1").textContent="";$("bk-e2").textContent="";setStep(1);if(!dlg.open)dlg.showModal();load();clearInterval(timer);timer=setInterval(()=>{if(step===2)load()},20000)}
