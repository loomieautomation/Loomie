function redraw(){drawCal();drawSlots();$("bk-pick").textContent=slot?F.format(slot)+" ("+TZN+" time)":"Select a time to continue.";const b=$("bk-ok");b.disabled=!slot||busy;b.textContent=busy?"Reserving...":"Confirm booking"}
async function load(){if(!configured||!sb)return;const{data,error}=await sb.rpc("get_taken_slots",{from_ts:new Date().toISOString(),to_ts:new Date(Date.now()+(AHEAD+2)*864e5).toISOString()});
if(error||!data)return;taken=new Set(data.map(r=>new Date(r.slot_start).getTime()));if(slot&&taken.has(slot))slot=null;if(step===2)redraw()}
function setStep(n){step=n;[1,2,3].forEach(i=>$("bk-s"+i).hidden=i!==n);$("bk-st").textContent=n===3?"All set":"Step "+n+" of 2";
$("bk-t").textContent=n===1?"Book your 20-minute chat":n===2?"Pick a day and time":"You’re booked!";
