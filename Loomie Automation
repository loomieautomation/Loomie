<script>(()=>{
const TZ="Europe/Skopje",TZN="Skopje",OPEN=9,CLOSE=17,AHEAD=60,LEAD=2; // business hours 09:00-17:00, weekdays, 60 days ahead, 2h notice
const $=id=>document.getElementById(id),dlg=$("bk"),pad=n=>String(n).padStart(2,"0");
const F=new Intl.DateTimeFormat("en-GB",{weekday:"long",day:"numeric",month:"long",hour:"2-digit",minute:"2-digit",hourCycle:"h23",timeZone:TZ});
let step=1,view,sel,slot,taken=new Set(),timer,busy=false;
function parts(ts){const o={};new Intl.DateTimeFormat("en-US",{timeZone:TZ,hourCycle:"h23",year:"numeric",month:"numeric",day:"numeric",hour:"numeric",minute:"numeric",second:"numeric"}).formatToParts(new Date(ts)).forEach(p=>o[p.type]=+p.value);return o}
const wallMs=o=>Date.UTC(o.year,o.month-1,o.day,o.hour,o.minute,o.second);
function zoned(y,m,d,h,mi){const g=Date.UTC(y,m,d,h,mi),off=wallMs(parts(g))-g;let t=g-off;const off2=wallMs(parts(t))-t;if(off2!==off)t=g-off2;return t}
const today=()=>{const o=parts(Date.now());return{y:o.year,m:o.month-1,d:o.day}};
const dayNum=(y,m,d)=>Date.UTC(y,m,d)/864e5;
function slotsOf(y,m,d){const r=[];for(let h=OPEN;h<CLOSE;h++)for(const mi of[0,30]){const t=zoned(y,m,d,h,mi);r.push({t,l:pad(h)+":"+pad(mi),ok:t>Date.now()+LEAD*36e5&&!taken.has(t)})}return r}
function dayState(y,m,d){const t=today(),n=dayNum(y,m,d)-dayNum(t.y,t.m,t.d),wd=new Date(Date.UTC(y,m,d)).getUTCDay();if(n<0||n>AHEAD||wd===0||wd===6)return"off";return slotsOf(y,m,d).some(s=>s.ok)?"ok":"full"}
function autoPick(){const t=today();for(let i=0;i<=AHEAD;i++){const x=new Date(Date.UTC(t.y,t.m,t.d+i)),y=x.getUTCFullYear(),m=x.getUTCMonth(),d=x.getUTCDate();if(dayState(y,m,d)==="ok"){sel={y,m,d};view={y,m};return}}view={y:t.y,m:t.m}}
function drawCal(){const{y,m}=view,t=today(),e=parts(Date.now()+AHEAD*864e5);
$("bk-mon").textContent=new Intl.DateTimeFormat("en-GB",{month:"long",year:"numeric",timeZone:"UTC"}).format(Date.UTC(y,m,1));
$("bk-prev").disabled=y*12+m<=t.y*12+t.m;$("bk-next").disabled=y*12+m>=e.year*12+e.month-1;
const first=(new Date(Date.UTC(y,m,1)).getUTCDay()+6)%7,len=new Date(Date.UTC(y,m+1,0)).getUTCDate();let h="";
for(let i=0;i<first;i++)h+="<i></i>";
for(let d=1;d<=len;d++){const s=dayState(y,m,d),on=sel&&sel.y===y&&sel.m===m&&sel.d===d;h+=`<button type="button" class="${s}${on?" on":""}" data-d="${d}" ${s==="ok"?"":"disabled"}${s==="full"?' title="Fully booked"':""}>${d}</button>`}
$("bk-days").innerHTML=h}
function drawSlots(){const b=$("bk-slots");if(!sel){b.innerHTML='<p class="hint">Choose a day to see available times.</p>';return}
