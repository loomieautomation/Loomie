const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZrZXFxbWtsZ2JhYXhjY2Nya3d0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE4Njk0MjcsImV4cCI6MjEwNzQ0NTQyN30.k-NTo9uLglIQblmbL9SFul-0AMy7-7fKUjG0j0ujZiQ";
